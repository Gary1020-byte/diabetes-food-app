/lib/generated_plugin_registrant.dart

# Exceptions to above rules.
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3
!/packages/flutter_tools/test/data/dart_dependencies/assets/packages

# Secrets — never commit these (signing keys, tokens, local config)
*.jks
*.keystore
*.pem
*.key
.env.*
!.env.example
local.properties
key.properties
